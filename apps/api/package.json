{
  "name": "@football/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=../../.env --import tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@football/auth": "workspace:*",
    "@football/contracts": "workspace:*",
    "@football/database": "workspace:*",
    "@football/observability": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@football/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
