# Environment contract
# REQUIRED PRODUCTION: DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL,
# WEB_URL, ADMIN_URL, NEXT_PUBLIC_API_URL, SUPPORT_EMAIL, SMTP_HOST, MAIL_FROM,
# OBJECT_STORAGE_* credentials/config, APP_VERSION, GIT_SHA, BUILD_TIMESTAMP.
# OPTIONAL: explicit pool/timeouts, SMTP relay credentials, Google OAuth.
# DEVELOPMENT ONLY: PRODUCTION_RUNTIME=false and localhost URLs.
# SANDBOX ONLY: SANDBOX_*; never set them on a production host.

# Database — REQUIRED
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_platform

# Authentication — REQUIRED except optional Google OAuth/TTL overrides
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
AUTH_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=3600
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public/runtime URLs — REQUIRED (HTTPS in production)
API_HOST=0.0.0.0
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PRODUCTION_RUNTIME=false
SUPPORT_EMAIL=support@example.com
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# SMTP — REQUIRED in production; credentials may be omitted only for a trusted relay
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=F5 Groups <no-reply@example.com>

# Player avatar object storage — REQUIRED and private in production
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=football-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_READINESS_CHECK=true

# Runtime — metadata is REQUIRED in production; tuning values are OPTIONAL
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=20000
DB_CONNECTION_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000
APP_VERSION=
GIT_SHA=
BUILD_TIMESTAMP=

# Operations — release host only; never inject backup credentials into Web/Admin/API
# RELEASE_SMOKE_DATABASE_URL and RESTORE_* must always target disposable/non-production DBs.
RELEASE_SMOKE_DATABASE_URL=
BACKUP_DIR=
BACKUP_FILE=
BACKUP_OFFSITE_REQUIRED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
RESTORE_DATABASE_URL=
RESTORE_DUMP_FILE=
RESTORE_CONFIRM=

# SANDBOX ONLY (commands reject non-_sandbox database names)
SANDBOX_DATABASE_URL=
SANDBOX_CONFIRM=
SANDBOX_SEED=20260902
