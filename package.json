{
  "name": "football-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "db:migrate": "pnpm --filter @football/database db:migrate",
    "db:migrate:smoke": "node --env-file-if-exists=.env scripts/release-migration-smoke.mjs",
    "prod:check": "pnpm --filter @football/api prod:check",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "db:backup:offsite": "pnpm --filter @football/api backup:offsite",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-db.mjs",
    "e2e:prepare": "node --env-file-if-exists=.env scripts/prepare-e2e-db.mjs",
    "e2e": "pnpm e2e:prepare && node scripts/build-e2e.mjs && node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "e2e:critical": "pnpm e2e --project=chromium --grep @critical",
    "perf:read-models": "node --env-file-if-exists=.env scripts/measure-read-models.mjs",
    "sandbox:reset": "node --env-file-if-exists=.env scripts/sandbox/reset.mjs",
    "sandbox:seed": "pnpm --filter @football/database build && pnpm --filter @football/auth build && pnpm --filter @football/api build && node --env-file-if-exists=.env scripts/sandbox/seed.mjs",
    "sandbox:rebuild": "pnpm sandbox:reset && pnpm sandbox:seed",
    "sandbox:guards": "node --test scripts/sandbox/guards.test.mjs",
    "dev:sandbox": "node --env-file-if-exists=.env scripts/sandbox/dev.mjs",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "node --env-file-if-exists=.env scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
